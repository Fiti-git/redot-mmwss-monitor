# Add this BEFORE the existing catch-all `handle { reverse_proxy frontend:3000 }`
# inside the {$PUBLIC_DOMAIN:coldcalling.redotglobal.agency} block in
# /srv/callora/repo/Caddyfile.
#
# NOTE: NO path stripping. The FastAPI app expects the full /mmwss/* prefix.
# Routes are registered with prefix="/mmwss" so RedirectResponse + template
# url generation produce paths the browser can hit directly.
#
# Reload Caddy after editing:
#   sudo docker exec callora-caddy caddy reload --config /etc/caddy/Caddyfile

handle /mmwss /mmwss/* {
    reverse_proxy mmwss-app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
