# Copy to /srv/mmwss/.env on the VPS — never commit a real .env.
# Generate strong values:
#   MMWSS_DB_PASSWORD : openssl rand -hex 24
#   MMWSS_MASTER_KEY  : openssl rand -hex 32  (must be exactly 64 hex chars)

MMWSS_DB_PASSWORD=replace_me_with_random_24_byte_hex
MMWSS_MASTER_KEY=replace_me_with_random_32_byte_hex_exactly_64_chars

# Cloudflare bootstrap token — pasted on first deploy.
# Same token from the original /srv/.../callora .env (CLOUDFLARE_API_TOKEN).
# After first sync it's encrypted into mmwss.cf_tokens and can be removed.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TOKEN_LABEL=primary
