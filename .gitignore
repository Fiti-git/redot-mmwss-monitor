node_modules/
.next/
out/
.turbo/
.cache/
*.tsbuildinfo
.npm/
.yarn/
.pnp.*

# ─── Generated artifacts (regenerable, no value in git) ───
cf_report.html
cf_report.json
cf_overview.json
reports/
*.log
*.sqlite
*.db

