# ─── Secrets — never commit ───
.env
.env.*
!.env.example
/secrets/                            # root-level secrets dir (deliberately broad)
ops/secrets/secrets.yaml             # plaintext intermediate — never commit
ops/secrets/*.dec.yaml               # any decrypted output
# ops/secrets/secrets.enc.yaml is SOPS-encrypted and SAFE to commit (it lives here on purpose)
*.pem
*.key
*.crt
*.pfx
age.key                              # SOPS age private keys — NEVER in git
cookies.txt
credentials.json
service-account*.json

# ─── Python ───
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

