# ─── Cloudflare ───
# API token with Zone:Read + Analytics:Read + DNS:Read on target zones.
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ─── Postgres (mmwss schema inside shared callora-db) ───
# In production this is set by ops/docker-compose.yml via Docker secret.
# Locally point at your dev Postgres.
DATABASE_URL=postgresql://mmwss:CHANGE_ME@localhost:5432/callora?schema=mmwss

# ─── App secrets ───
# 32-byte hex string used to AES-encrypt Cloudflare tokens at rest.
# Generate: openssl rand -hex 32
MMWSS_MASTER_KEY=replace_with_32_bytes_hex

# Used by NextAuth to sign session cookies.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_string

# Public URL (used for callbacks and links in emails)
NEXTAUTH_URL=https://coldcalling.redotglobal.agency/mmwss

# ─── WPMUDEV (Phase 2 — leave blank for Phase 1) ───
WPMUDEV_API_KEY=
