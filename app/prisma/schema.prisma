// MMWSS Prisma schema — generated from the SQL migration (db/migrations/001_initial.sql).
// Use `prisma generate` only; do NOT run `prisma migrate` against this DB
// (the SQL migrations are the source of truth, applied by the collector container).

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["mmwss"]
}

enum UserRole {
  admin
  viewer
  @@map("user_role")
  @@schema("mmwss")
}

enum IncidentSeverity {
  critical
  warning
  info
  @@map("incident_severity")
  @@schema("mmwss")
}

enum IncidentType {
  site_down
  ssl_expiring
  ssl_expired
  threat_spike
  config_drift
  cert_renewed
  @@map("incident_type")
  @@schema("mmwss")
}

enum ReportType {
  daily
  weekly
  monthly
  adhoc
  @@map("report_type")
  @@schema("mmwss")
}

model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique @db.Citext
  name          String
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(viewer)
  mfaSecret     String?   @map("mfa_secret")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  sessions      Session[]

  @@map("users")
  @@schema("mmwss")
}

model Session {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("mmwss")
}

model CfToken {
  id              BigInt   @id @default(autoincrement())
  label           String   @unique
  encryptedToken  Bytes    @map("encrypted_token")
  last4           String   @map("last_4")
  scopesJson      Json?    @map("scopes_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  addedByUserId   BigInt?  @map("added_by_user_id")
  zones           Zone[]

  @@map("cf_tokens")
  @@schema("mmwss")
}

model Zone {
  id                BigInt          @id @default(autoincrement())
  cfZoneId          String          @unique @map("cf_zone_id")
  cfTokenId         BigInt          @map("cf_token_id")
  name              String
  plan              String?
  status            String?
  nameServersJson   Json?           @map("name_servers_json")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  lastSyncedAt      DateTime?       @map("last_synced_at") @db.Timestamptz
  cfToken           CfToken         @relation(fields: [cfTokenId], references: [id])
  snapshots         ZoneSnapshot[]
  analytics         AnalyticsHourly[]
  uptimeChecks      UptimeCheck[]
  incidents         Incident[]

  @@map("zones")
  @@schema("mmwss")
}

model ZoneSnapshot {
  id                BigInt    @id @default(autoincrement())
  zoneId            BigInt    @map("zone_id")
  capturedAt        DateTime  @default(now()) @map("captured_at") @db.Timestamptz
  settingsJson      Json      @map("settings_json")
  sslExpiry         DateTime? @map("ssl_expiry") @db.Timestamptz
  sslPacksActive    Int?      @map("ssl_packs_active")
  fwRulesTotal      Int?      @map("fw_rules_total")
  fwRulesEnabled    Int?      @map("fw_rules_enabled")
  dnsCount          Int?      @map("dns_count")
  dnsByTypeJson     Json?     @map("dns_by_type_json")
  dnsProxiedCount   Int?      @map("dns_proxied_count")
  zone              Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("zone_snapshots")
  @@schema("mmwss")
}

model AnalyticsHourly {
  zoneId          BigInt   @map("zone_id")
  hour            DateTime @db.Timestamptz
  requests        BigInt   @default(0)
  cachedRequests  BigInt   @default(0) @map("cached_requests")
  bytes           BigInt   @default(0)
  cachedBytes     BigInt   @default(0) @map("cached_bytes")
  threats         BigInt   @default(0)
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  zone            Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([zoneId, hour])
  @@map("analytics_hourly")
  @@schema("mmwss")
}

model UptimeCheck {
  id            BigInt   @id @default(autoincrement())
  zoneId        BigInt   @map("zone_id")
  checkedAt     DateTime @default(now()) @map("checked_at") @db.Timestamptz
  statusCode    Int?     @map("status_code")
  latencyMs     Int?     @map("latency_ms")
  ok            Boolean
  errorMessage  String?  @map("error_message")
  probeLocation String   @default("callora-sg") @map("probe_location")
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("uptime_checks")
  @@schema("mmwss")
}

model Incident {
  id            BigInt           @id @default(autoincrement())
  zoneId        BigInt           @map("zone_id")
  type          IncidentType
  severity      IncidentSeverity
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz
  endedAt       DateTime?        @map("ended_at") @db.Timestamptz
  summary       String
  detailsJson   Json?            @map("details_json")
  resolved      Boolean
  zone          Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("incidents")
  @@schema("mmwss")
}

model Report {
  id                  BigInt     @id @default(autoincrement())
  type                ReportType
  periodStart         DateTime   @map("period_start") @db.Timestamptz
  periodEnd           DateTime   @map("period_end") @db.Timestamptz
  htmlPath            String?    @map("html_path")
  pdfPath             String?    @map("pdf_path")
  summaryJson         Json?      @map("summary_json")
  generatedAt         DateTime   @default(now()) @map("generated_at") @db.Timestamptz
  generatedByUserId   BigInt?    @map("generated_by_user_id")
  downloadedCount     Int        @default(0) @map("downloaded_count")

  @@map("reports")
  @@schema("mmwss")
}
