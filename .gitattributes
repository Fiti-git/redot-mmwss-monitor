# Force LF for everything that runs on Linux (Docker, bash, Python).
# Without this, Windows checkouts produce CRLF that breaks shebangs
# and ENTRYPOINTs on Linux containers.

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.md        text eol=lf

# Treat binaries explicitly so git doesn't try to normalize them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.svg       text eol=lf
*.pdf       binary
